<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="eDiagnosticPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Déclaration des entités -->
        <class>com.ediagnostic.model.Utilisateur</class>
        <class>com.ediagnostic.model.Infirmier</class>
        <class>com.ediagnostic.model.MedecinGeneraliste</class>
        <class>com.ediagnostic.model.MedecinSpecialiste</class>
        <class>com.ediagnostic.model.Patient</class>
        <class>com.ediagnostic.model.SigneVital</class>
        <class>com.ediagnostic.model.Consultation</class>
        <class>com.ediagnostic.model.Creneau</class>
        <class>com.ediagnostic.model.ActeTechnique</class>
        <class>com.ediagnostic.model.DemandeTeleExpertise</class>

        <properties>
            <!-- Configuration JDBC  -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/ediagnostic_db" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="postgres" />

            <!-- Hibernate  -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />

            <!-- Génération automatique des tables -->
            <property name="hibernate.hbm2ddl.auto" value="update" />
        </properties>
        
    </persistence-unit>
</persistence>